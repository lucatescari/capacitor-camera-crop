{
  "name": "capacitor-camera-crop",
  "version": "2.0.0",
  "type": "module",
  "description": "A Capacitor plugin providing native camera and crop support.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/build.gradle",
    "android/src",
    "android/gradle.properties",
    "android/proguard-rules.pro",
    "dist/",
    "ios/Plugin/",
    "Package.swift",
    "CapacitorCameraCrop.podspec"
  ],
  "author": "Luca Tescari <luca@tescari.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucatescari/capacitor-camera-crop"
  },
  "bugs": {
    "url": "https://github.com/lucatescari/capacitor-camera-crop/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "camera",
    "crop"
  ],
  "scripts": {
    "build": "bun run clean && tsc && rollup -c rollup.config.js",
    "clean": "rm -rf ./dist",
    "watch": "tsc --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "validate": "node validate.cjs",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "prettier": "^3.1.0",
    "rollup": "^4.9.1",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@capacitor/core": "^7.0.0 || ^8.0.0"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}

