# Native platform folders (ios/ and android/) ARE committed so the example is
# turnkey. Build artifacts inside them are excluded by their own nested
# .gitignore files (ios/.gitignore, android/.gitignore) — e.g. local.properties,
# build/, DerivedData, copied web assets, and generated capacitor.config.json.

# Build output (Vite) — regenerated by `npm run build`
/dist/

